{
  "name": "reversa-views",
  "version": "0.0.1",
  "publisher": "iagoleal-local",
  "private": true,
  "description": "Camada de leitura do processo do Reversa, herdada de scrum-harness",
  "engines": {
    "vscode": "^1.78.0"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onView:reversaViews.process"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "reversa-views",
          "title": "Reversa",
          "icon": "media/reversa.svg"
        }
      ]
    },
    "views": {
      "reversa-views": [
        {
          "id": "reversaViews.process",
          "name": "Processo",
          "type": "webview"
        }
      ]
    },
    "commands": [
      {
        "command": "reversaViews.abrir",
        "title": "Abrir o painel do processo",
        "category": "Reversa"
      },
      {
        "command": "reversaViews.reload",
        "title": "Reler o processo",
        "category": "Reversa"
      }
    ],
    "configuration": {
      "title": "Reversa",
      "properties": {
        "reversaViews.conferirAtualizacao": {
          "type": "boolean",
          "default": true,
          "description": "Conferir, a cada leitura do processo, se esta instalação está atrás da origem do repositório. A consulta é anônima e de leitura: não carrega credencial, identificador de máquina, nome de workspace nem dado algum sobre o que foi lido. Desligada, o painel declara que está desligada em vez de silenciar."
        }
      }
    }
  },
  "scripts": {
    "pretest": "npm run gerar:carimbo",
    "test": "vitest run",
    "typecheck": "tsc -p ./ --noEmit",
    "compile": "tsc -p ./",
    "build:webview": "node scripts/build-webview.js",
    "build": "npm run check:heranca:local && npm run gerar:revisao-heranca && npm run gerar:carimbo && npm run compile && npm run build:webview",
    "check:webview": "tsc -p tsconfig.webview.json --noEmit",
    "check:heranca": "node scripts/verificar-heranca.js",
    "check:heranca:local": "node scripts/verificar-heranca.js --local",
    "sync:heranca": "node scripts/ressincronizar-heranca.js",
    "gerar:revisao-heranca": "node scripts/gerar-revisao-heranca.js",
    "gerar:carimbo": "node scripts/gerar-carimbo-da-construcao.js",
    "preview": "node scripts/preview.js",
    "empacotar": "node scripts/empacotar.js",
    "atualizar": "node scripts/atualizar.js",
    "observar:webview": "node scripts/build-webview.js --observar",
    "estragar:workspace": "node scripts/estragar-workspace.js",
    "estragar:registro": "node scripts/estragar-registro.js",
    "estragar:greenfield": "node scripts/estragar-greenfield.js",
    "estragar:descoberta": "node scripts/estragar-descoberta.js",
    "aprender:equivalencias": "node scripts/aprender-equivalencias.js",
    "promover:equivalencias": "node scripts/promover-equivalencias.js",
    "prompt:harness": "node scripts/prompt-harness.js",
    "compile:cli": "npm run gerar:carimbo && tsc -p tsconfig.cli.json",
    "prepainel": "npm run compile:cli",
    "painel": "node scripts/painel.js",
    "precontar:anomalias": "npm run compile:cli",
    "contar:anomalias": "node scripts/contar-anomalias.js",
    "preaprender:equivalencias": "npm run compile:cli",
    "prepromover:equivalencias": "npm run compile:cli"
  },
  "devDependencies": {
    "@primer/primitives": "11.10.0",
    "@types/node": "20.19.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/vscode": "1.78.0",
    "@vitest/coverage-v8": "3.2.7",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.25.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.9.3",
    "vitest": "3.2.7",
    "yaml": "2.9.0"
  }
}
