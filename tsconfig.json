{
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "lib": ["ES2022"],
    "strict": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "rootDir": "src",
    "outDir": "out",
    "types": ["node"],
    "sourceMap": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/heranca/**/tests/**"]
}
