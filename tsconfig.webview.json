{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "rootDir": "src",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": [],
    "skipLibCheck": true,
    "paths": {
      "vscode": [
        "./types/editor-api-is-out-of-reach.d.ts"
      ]
    },
    "baseUrl": "."
  },
  "include": [
    "src/webview/**/*",
    "types/inherited-platform.d.ts",
    "types/editor-api-is-out-of-reach.d.ts"
  ]
}
