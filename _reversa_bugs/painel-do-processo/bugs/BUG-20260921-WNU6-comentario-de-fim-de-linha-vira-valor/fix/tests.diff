+describe('comentário de fim de linha não é valor (BUG-20260921-WNU6)', () => {
+  /** Um bloco de uma linha só, ou de várias. */
+  function bloco(...linhas: string[]): string {
+    return ['---', ...linhas, '---', ''].join('\n')
+  }
+
+  it('a linha real do SRSK do afla lê como lista vazia', () => {
+    const linha =
+      'blocking: []   # bloqueio externo de 2026-08-24 (G-32) levantado pelo mantenedor em 2026-09-14'
+    expect(readFrontMatter(bloco(linha)).listas.blocking).toBe(false)
+  })
+
+  it('lista em linha povoada, com comentário, continua povoada', () => {
+    expect(readFrontMatter(bloco('blocking: [espera externa]  # nota')).listas.blocking).toBe(true)
+  })
+
+  it('escalar com comentário devolve só o escalar', () => {
+    const lido = readFrontMatter(bloco('severity: high  # nota', 'module: sync   # termo acolhido'))
+    expect(lido.escalares.severity).toBe('high')
+    expect(lido.escalares.module).toBe('sync')
+  })
+
+  it('chave cujo valor é só comentário abre a lista que vem abaixo', () => {
+    const lido = readFrontMatter(bloco('blocking:   # nota', '  - espera externa'))
+    expect(lido.listas.blocking).toBe(true)
+    expect(lido.escalares.blocking).toBeUndefined()
+  })
+
+  it('cerquilha dentro de aspas continua no valor', () => {
+    const lido = readFrontMatter(
+      bloco('title: "Painel # 3: a contagem diverge"', "outro: 'a # b'  # nota"),
+    )
+    expect(lido.escalares.title).toBe('Painel # 3: a contagem diverge')
+    expect(lido.escalares.outro).toBe('a # b')
+  })
+
+  it('aspa escapada não fecha o valor antes da hora', () => {
+    expect(readFrontMatter(bloco('title: "a \\" # b"')).escalares.title).toBe('a \\" # b')
+  })
+
+  it('cerquilha sem espaço antes continua no valor', () => {
+    expect(readFrontMatter(bloco('title: cor#fff sem espaco')).escalares.title).toBe(
+      'cor#fff sem espaco',
+    )
+  })
+
+  it('apóstrofo no meio de escalar simples não abre aspas', () => {
+    expect(readFrontMatter(bloco("title: it's here # nota")).escalares.title).toBe("it's here")
+  })
+})
+
