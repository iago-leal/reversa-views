+/** Onde o ritual mora dentro do clone, relativo à raiz. */
+const CAMINHO_DO_RITUAL = 'scripts/atualizar.js'
+
+/**
+ * A linha do segundo ato, executável do diretório em que o leitor estiver
+ * (BUG-20260911-FI3O).
+ *
+ * Esta é a única grafia do ato deste lado, e `updateCommand`, em
+ * `src/webview/domain/labels.ts`, é a do outro. As duas seguem a mesma regra e
+ * a suíte as compara função contra função, e não mais texto contra expressão
+ * regular: a ponte que o BUG-20260910-WIBK deixou conferia a grafia, e esta
+ * confere a regra.
+ *
+ * Sem raiz, recua para a grafia do clone: quem não tem endereço não recebe um
+ * caminho plausível e falso. O caminho sai entre aspas só quando carrega
+ * espaço, porque aspas atrapalham a leitura e a maioria dos caminhos não
+ * precisa delas.
+ * @param {string|null|undefined} raiz - a raiz do clone, quando se sabe qual é.
+ * @returns {string} a linha a copiar.
+ */
+function comandoDeAplicacao(raiz) {
+  if (typeof raiz !== 'string' || raiz === '') return 'npm run atualizar -- --aplicar'
+  const caminho = `${raiz.replace(/\/+$/, '')}/${CAMINHO_DO_RITUAL}`
+  return /\s/.test(caminho) ? `node "${caminho}" --aplicar` : `node ${caminho} --aplicar`
+}
 
