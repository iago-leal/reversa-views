+    expect(m.feito).toEqual([
+      'buscar',
+      'npm run build',
+      'npm test',
+      'npm run empacotar',
+      'instalar reversa-views-0.6.2.vsix',
+    ])
+  })
+
+  it('em dia, o percurso roda sem incorporar nada: a incorporação segue condicionada (W004)', () => {
